{
  "name": "pisla",
  "productName": "PiSLA",
  "version": "1.8.4",
  "description": "PiSLA - محلل دروس التعليم الصريح",
  "author": "PiSLA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.pisla.app",
    "productName": "PiSLA",
    "files": ["main.js", "app/**/*"],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "PiSLA-${version}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
